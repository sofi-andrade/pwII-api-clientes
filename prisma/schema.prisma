generator cliente{
    provider = "prisma-client-js"
}
datasource db { 
    provider = "mysql"
    url = env("DB_CONNECTION")
}

model cliente {
    id Int @id @default(autoincrement())
    nome String
    telefone String?
    endereco String?
    ativo Boolean @default (true)

    @@map("cliente") 
    
}
